# ============================================================
# WarehouseVision — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# --------------------------
# Database (required)
# --------------------------
# Neon PostgreSQL connection string — get it from https://neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --------------------------
# AI Providers (at least one required)
# --------------------------

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=...

# OpenRouter (for Llama models) — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Roboflow (optional, for YOLO CNN models) — https://roboflow.com/
ROBOFLOW_API_KEY=...

# --------------------------
# Server
# --------------------------
PORT=5000
NODE_ENV=production

# --------------------------
# Replit AI Integrations (only needed when running on Replit)
# These override the standard API keys above when set.
# --------------------------
# AI_INTEGRATIONS_OPENAI_BASE_URL=
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_GEMINI_API_KEY=
# AI_INTEGRATIONS_GEMINI_BASE_URL=
# AI_INTEGRATIONS_OPENROUTER_API_KEY=
# AI_INTEGRATIONS_OPENROUTER_BASE_URL=
